# Self-Correcting API Broker — Environment Variables
# Copy this file to .env and fill in the values.

# ─── Application ───────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-use-a-real-secret-key-at-least-32-chars
LOG_LEVEL=INFO

# ─── Database (PostgreSQL + pgvector) ──────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=broker_db
POSTGRES_USER=broker
POSTGRES_PASSWORD=change-me-db-password

DATABASE_URL=postgresql+asyncpg://broker:change-me-db-password@db:5432/broker_db
DATABASE_URL_SYNC=postgresql://broker:change-me-db-password@db:5432/broker_db

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://broker:change-me-db-password@db:5432/broker_test_db

# ─── LLM Providers (optional — broker degrades gracefully) ─────
# Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# Active provider: gemini | groq | mock (default: mock in dev)
LLM_PROVIDER=mock

# LLM budget
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_COST_BUDGET_USD_PER_REQUEST=0.05

# ─── Recovery engine ──────────────────────────────────────────
# Confidence gate thresholds (configurable experimental parameters)
CONFIDENCE_THRESHOLD=0.65
MIN_EVIDENCE_COUNT=2
RANKING_WEIGHT_GRAPH_SIMILARITY=0.30
RANKING_WEIGHT_HISTORICAL_SUCCESS=0.25
RANKING_WEIGHT_SCHEMA_COMPATIBILITY=0.20
RANKING_WEIGHT_FAILURE_MATCH=0.15
RANKING_WEIGHT_PROVENANCE_QUALITY=0.10

# ─── Upstream execution ────────────────────────────────────────
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_REDIRECTS=3
UPSTREAM_VERIFY_TLS=true
# Comma-separated allowed upstream hostnames (empty = registry only)
UPSTREAM_ALLOWED_HOSTS=

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000
